# Local development ports and passwords. Copy to .env (gitignored) and adjust; every value is optional.
# Only the host side changes: containers keep talking to each other on their internal ports.
# Defaults below are the stock ports; pick free ones if other containers already use them.
# Browsers refuse ports 6665-6669 (ERR_UNSAFE_PORT): keep FRONTEND, ACCESS, AIRFLOW, PROMETHEUS and GRAFANA off them.
# Loaded by `task` (root Taskfile). Use `task dev:*`; bare `docker compose` does not read this file.

PERSISTENCE_DB_PORT=1521  # Oracle
ACCESS_PORT=8000          # access API
PERSISTENCE_PORT=8001     # persistence API
PROCESSING_PORT=8002      # processing API
INGESTION_PORT=8003       # ingestion API
FRONTEND_PORT=5174        # explorer (task frontend:dev)
AIRFLOW_PORT=8088         # Airflow UI (optional profile)
PROMETHEUS_PORT=9090      # Prometheus (optional observability)
TEMPO_PORT=3200           # Tempo (optional observability)
GRAFANA_PORT=3300         # Grafana (optional observability)
