{
  "components": {
    "schemas": {
      "ChangeReason": {
        "description": "Why a version exists.",
        "enum": [
          "initial",
          "revision",
          "correction",
          "recalculation",
          "simulated"
        ],
        "title": "ChangeReason",
        "type": "string"
      },
      "ChangesMeta": {
        "additionalProperties": false,
        "description": "The two knowledge times the changes were determined between.",
        "properties": {
          "as_of": {
            "description": "Later knowledge time (UTC) of the comparison",
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "since": {
            "description": "Earlier knowledge time (UTC) of the comparison",
            "format": "date-time",
            "title": "Since",
            "type": "string"
          },
          "source_attribution": {
            "description": "Required attribution of the source values (ESCB reuse terms); for simulated data a note that it is simulated",
            "examples": [
              "Source: ECB statistics"
            ],
            "title": "Source Attribution",
            "type": "string"
          }
        },
        "required": [
          "since",
          "as_of",
          "source_attribution"
        ],
        "title": "ChangesMeta",
        "type": "object"
      },
      "CurveChanges": {
        "additionalProperties": false,
        "description": "The changes of one curve over a range of valid dates, in valid-date and grid order.",
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/ValueChange"
            },
            "title": "Changes",
            "type": "array"
          },
          "curve_id": {
            "examples": [
              "ecb-aaa-spot"
            ],
            "maxLength": 64,
            "minLength": 1,
            "title": "Curve Id",
            "type": "string"
          },
          "valid_from": {
            "description": "Valid time: first valid date of the range (inclusive)",
            "format": "date",
            "title": "Valid From",
            "type": "string"
          },
          "valid_to": {
            "description": "Valid time: last valid date of the range (inclusive)",
            "format": "date",
            "title": "Valid To",
            "type": "string"
          }
        },
        "required": [
          "curve_id",
          "valid_from",
          "valid_to",
          "changes"
        ],
        "title": "CurveChanges",
        "type": "object"
      },
      "CurveChangesResponse": {
        "additionalProperties": false,
        "description": "Body of ``GET`` on the :data:`CURVE_CHANGES_PATH` endpoint.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurveChanges"
          },
          "meta": {
            "$ref": "#/components/schemas/ChangesMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "CurveChangesResponse",
        "type": "object"
      },
      "CurveMeta": {
        "additionalProperties": false,
        "description": "How the answer was determined.",
        "properties": {
          "as_of": {
            "description": "Effective knowledge time (UTC): the requested as_of, or the knowledge horizon if that is later or no as_of was requested",
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "source_attribution": {
            "description": "Required attribution of the source values (ESCB reuse terms); for simulated data a note that it is simulated",
            "examples": [
              "Source: ECB statistics"
            ],
            "title": "Source Attribution",
            "type": "string"
          }
        },
        "required": [
          "as_of",
          "source_attribution"
        ],
        "title": "CurveMeta",
        "type": "object"
      },
      "CurveObservations": {
        "additionalProperties": false,
        "description": "One curve on one valid date, with its points in grid order.",
        "properties": {
          "curve_id": {
            "examples": [
              "ecb-aaa-spot"
            ],
            "maxLength": 64,
            "minLength": 1,
            "title": "Curve Id",
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/CurvePoint"
            },
            "title": "Points",
            "type": "array"
          },
          "valid_date": {
            "description": "Valid time: the business date of the curve",
            "format": "date",
            "title": "Valid Date",
            "type": "string"
          }
        },
        "required": [
          "curve_id",
          "valid_date",
          "points"
        ],
        "title": "CurveObservations",
        "type": "object"
      },
      "CurveObservationsResponse": {
        "additionalProperties": false,
        "description": "Body of ``GET /v1/curves/{curve_id}/observations``.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurveObservations"
          },
          "meta": {
            "$ref": "#/components/schemas/CurveMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "CurveObservationsResponse",
        "type": "object"
      },
      "CurvePoint": {
        "additionalProperties": false,
        "description": "One maturity of a curve on the common grid.",
        "properties": {
          "maturity": {
            "description": "Tenor code, e.g. 3M, 10Y",
            "examples": [
              "10Y"
            ],
            "title": "Maturity",
            "type": "string"
          },
          "months": {
            "description": "Length of the tenor in months, for ordering",
            "exclusiveMinimum": 0.0,
            "title": "Months",
            "type": "integer"
          },
          "origin": {
            "$ref": "#/components/schemas/Origin",
            "description": "published: the source value, unmodified; derived: computed by the service (none yet)"
          },
          "quality": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValueQuality"
              },
              {
                "type": "null"
              }
            ],
            "description": "Quality status of the value; null exactly when value is null"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Yield in percent; null if no published value was known as of meta.as_of",
            "examples": [
              2.61
            ],
            "title": "Value"
          },
          "version_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Version id of the visible version, the lineage reference: the version_id the versions endpoint lists for this value; null exactly when value is null",
            "examples": [
              7
            ],
            "title": "Version Id"
          }
        },
        "required": [
          "maturity",
          "months",
          "value",
          "version_id",
          "origin",
          "quality"
        ],
        "title": "CurvePoint",
        "type": "object"
      },
      "Origin": {
        "description": "How a value came to be: published by its source, or derived by the service.",
        "enum": [
          "published",
          "derived"
        ],
        "title": "Origin",
        "type": "string"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "RFC 9457 problem details, the body of every error response.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "type": "object"
      },
      "QualityFlag": {
        "additionalProperties": false,
        "description": "One rule finding on a published value.",
        "properties": {
          "evidence": {
            "description": "What was found, with the numbers",
            "title": "Evidence",
            "type": "string"
          },
          "explanation": {
            "description": "Why the rule exists, in user language",
            "title": "Explanation",
            "type": "string"
          },
          "rule": {
            "description": "Plausibility or completeness rule that produced the flag",
            "examples": [
              "range"
            ],
            "minLength": 1,
            "title": "Rule",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          }
        },
        "required": [
          "rule",
          "severity",
          "explanation",
          "evidence"
        ],
        "title": "QualityFlag",
        "type": "object"
      },
      "QualityStatus": {
        "description": "Outcome of checks: ``unchecked`` means no result is known for the value.",
        "enum": [
          "passed",
          "info",
          "warn",
          "unchecked"
        ],
        "title": "QualityStatus",
        "type": "string"
      },
      "SeriesObservations": {
        "additionalProperties": false,
        "description": "One maturity of a curve, with its points in valid-date order.",
        "properties": {
          "curve_id": {
            "examples": [
              "ecb-aaa-spot"
            ],
            "maxLength": 64,
            "minLength": 1,
            "title": "Curve Id",
            "type": "string"
          },
          "maturity": {
            "examples": [
              "10Y"
            ],
            "maxLength": 16,
            "minLength": 1,
            "title": "Maturity",
            "type": "string"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/SeriesPoint"
            },
            "title": "Points",
            "type": "array"
          }
        },
        "required": [
          "curve_id",
          "maturity",
          "points"
        ],
        "title": "SeriesObservations",
        "type": "object"
      },
      "SeriesObservationsResponse": {
        "additionalProperties": false,
        "description": "Body of ``GET /v1/curves/{curve_id}/maturities/{maturity}/observations``.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SeriesObservations"
          },
          "meta": {
            "$ref": "#/components/schemas/CurveMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "SeriesObservationsResponse",
        "type": "object"
      },
      "SeriesPoint": {
        "additionalProperties": false,
        "description": "One valid date with a published value known as of ``meta.as_of``.",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/Origin",
            "description": "published: the source value, unmodified; derived: computed by the service (none yet)"
          },
          "quality": {
            "$ref": "#/components/schemas/ValueQuality",
            "description": "Quality status of the value"
          },
          "valid_date": {
            "description": "Valid time: the business date of the value",
            "format": "date",
            "title": "Valid Date",
            "type": "string"
          },
          "value": {
            "description": "Yield in percent",
            "examples": [
              2.61
            ],
            "title": "Value",
            "type": "number"
          },
          "version_id": {
            "description": "Version id of the visible version, the lineage reference: the version_id the versions endpoint lists for this value",
            "title": "Version Id",
            "type": "integer"
          }
        },
        "required": [
          "valid_date",
          "value",
          "version_id",
          "origin",
          "quality"
        ],
        "title": "SeriesPoint",
        "type": "object"
      },
      "Severity": {
        "description": "How serious a flag is: ``warn`` is shown as a warning, ``info`` as a note.",
        "enum": [
          "warn",
          "info"
        ],
        "title": "Severity",
        "type": "string"
      },
      "ValueChange": {
        "additionalProperties": false,
        "description": "One published value whose visible version differs between the two knowledge times.",
        "properties": {
          "change_reason": {
            "$ref": "#/components/schemas/ChangeReason",
            "description": "Reason of the version known at meta.as_of"
          },
          "known_from": {
            "description": "Knowledge time (UTC) the version known at meta.as_of became known",
            "format": "date-time",
            "title": "Known From",
            "type": "string"
          },
          "maturity": {
            "examples": [
              "10Y"
            ],
            "maxLength": 16,
            "minLength": 1,
            "title": "Maturity",
            "type": "string"
          },
          "new_value": {
            "description": "Yield in percent known at meta.as_of",
            "examples": [
              2.7
            ],
            "title": "New Value",
            "type": "number"
          },
          "old_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Yield in percent known at meta.since; null when the value was not known then",
            "examples": [
              2.61
            ],
            "title": "Old Value"
          },
          "source_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "ecb"
            ],
            "title": "Source Id"
          },
          "valid_date": {
            "description": "Valid time: the business date of the value",
            "format": "date",
            "title": "Valid Date",
            "type": "string"
          }
        },
        "required": [
          "valid_date",
          "maturity",
          "old_value",
          "new_value",
          "change_reason",
          "source_id",
          "known_from"
        ],
        "title": "ValueChange",
        "type": "object"
      },
      "ValueQuality": {
        "additionalProperties": false,
        "description": "Quality of one published value, with the flags that apply to it.",
        "properties": {
          "flags": {
            "description": "Rule findings on this value; empty when status is passed or unchecked",
            "items": {
              "$ref": "#/components/schemas/QualityFlag"
            },
            "title": "Flags",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/QualityStatus"
          }
        },
        "required": [
          "status",
          "flags"
        ],
        "title": "ValueQuality",
        "type": "object"
      },
      "ValueVersion": {
        "additionalProperties": false,
        "description": "One stored version of a value, with its knowledge interval and provenance.",
        "properties": {
          "change_reason": {
            "$ref": "#/components/schemas/ChangeReason"
          },
          "delivery_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Raw source delivery the value came from",
            "examples": [
              "4711"
            ],
            "title": "Delivery Id"
          },
          "known_from": {
            "description": "Knowledge time (UTC) the version became known",
            "format": "date-time",
            "title": "Known From",
            "type": "string"
          },
          "known_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Knowledge time (UTC) the version stopped being current; null while it is still current as of meta.as_of",
            "title": "Known To"
          },
          "normalization_version": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Version of the source mapping that produced the value",
            "examples": [
              "1"
            ],
            "title": "Normalization Version"
          },
          "run_id": {
            "description": "Run that wrote the version",
            "maxLength": 128,
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "source_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "ecb"
            ],
            "title": "Source Id"
          },
          "value": {
            "description": "Yield in percent",
            "examples": [
              2.61
            ],
            "title": "Value",
            "type": "number"
          },
          "version_id": {
            "description": "Surrogate key of the version",
            "examples": [
              4711
            ],
            "title": "Version Id",
            "type": "integer"
          }
        },
        "required": [
          "version_id",
          "value",
          "known_from",
          "known_to",
          "source_id",
          "run_id",
          "change_reason",
          "normalization_version",
          "delivery_id"
        ],
        "title": "ValueVersion",
        "type": "object"
      },
      "ValueVersions": {
        "additionalProperties": false,
        "description": "The version history of one value, oldest version first.",
        "properties": {
          "curve_id": {
            "examples": [
              "ecb-aaa-spot"
            ],
            "maxLength": 64,
            "minLength": 1,
            "title": "Curve Id",
            "type": "string"
          },
          "maturity": {
            "examples": [
              "10Y"
            ],
            "maxLength": 16,
            "minLength": 1,
            "title": "Maturity",
            "type": "string"
          },
          "valid_date": {
            "description": "Valid time: the business date of the value",
            "format": "date",
            "title": "Valid Date",
            "type": "string"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/ValueVersion"
            },
            "title": "Versions",
            "type": "array"
          }
        },
        "required": [
          "curve_id",
          "maturity",
          "valid_date",
          "versions"
        ],
        "title": "ValueVersions",
        "type": "object"
      },
      "ValueVersionsResponse": {
        "additionalProperties": false,
        "description": "Body of ``GET`` on the :data:`VALUE_VERSIONS_PATH` endpoint.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ValueVersions"
          },
          "meta": {
            "$ref": "#/components/schemas/CurveMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "ValueVersionsResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "YieldLens access",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness: the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: the persistence service is reachable and ready.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/curves/{curve_id}/changes": {
      "get": {
        "description": "What changed in a curve over valid dates between ``since`` and ``as_of``.\n\nA change is a value whose visible version differs between the two knowledge times;\n``old_value`` is null when the value was not known at ``since``. Without ``as_of``\nthe store picks its default; the answer reports both knowledge times in ``meta``.",
        "operationId": "curve_changes_v1_curves__curve_id__changes_get",
        "parameters": [
          {
            "in": "path",
            "name": "curve_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Curve Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "format": "date",
              "title": "From",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "format": "date",
              "title": "To",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "since",
            "required": true,
            "schema": {
              "format": "date-time",
              "title": "Since",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurveChangesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "304": {
            "description": "Not modified: the ETag matches If-None-Match"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Curve Changes"
      }
    },
    "/v1/curves/{curve_id}/maturities/{maturity}/observations": {
      "get": {
        "description": "One maturity of a curve over valid dates, as it was known at ``meta.as_of``.\n\nWithout ``from``, ``to`` or ``as_of`` the store picks its defaults; the answer\nreports the knowledge time it used in ``meta.as_of``.",
        "operationId": "series_observations_v1_curves__curve_id__maturities__maturity__observations_get",
        "parameters": [
          {
            "in": "path",
            "name": "curve_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Curve Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "maturity",
            "required": true,
            "schema": {
              "maxLength": 16,
              "minLength": 1,
              "title": "Maturity",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
