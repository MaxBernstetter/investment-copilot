{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Run": {
        "additionalProperties": false,
        "description": "One attempt of a run of a service.",
        "properties": {
          "attempt": {
            "minimum": 1.0,
            "title": "Attempt",
            "type": "integer"
          },
          "delivered_count": {
            "description": "Observations the source delivered",
            "minimum": 0.0,
            "title": "Delivered Count",
            "type": "integer"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "error_message": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "error_type": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Type"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "operation": {
            "examples": [
              "daily"
            ],
            "maxLength": 32,
            "minLength": 1,
            "title": "Operation",
            "type": "string"
          },
          "recorded_count": {
            "description": "New versions stored",
            "minimum": 0.0,
            "title": "Recorded Count",
            "type": "integer"
          },
          "run_id": {
            "examples": [
              "daily_load_ecb-2026-10-16"
            ],
            "maxLength": 128,
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "service": {
            "examples": [
              "ingestion"
            ],
            "maxLength": 32,
            "minLength": 1,
            "title": "Service",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "unchanged_count": {
            "description": "Values already stored unchanged",
            "minimum": 0.0,
            "title": "Unchanged Count",
            "type": "integer"
          }
        },
        "required": [
          "run_id",
          "attempt",
          "service",
          "operation",
          "status",
          "started_at",
          "finished_at",
          "delivered_count",
          "recorded_count",
          "unchanged_count"
        ],
        "title": "Run",
        "type": "object"
      },
      "RunAttemptsResponse": {
        "additionalProperties": false,
        "description": "Body of ``GET /v1/runs/{run_id}``: every attempt, in attempt order.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "title": "Data",
            "type": "array"
          }
        },
        "required": [
          "data"
        ],
        "title": "RunAttemptsResponse",
        "type": "object"
      },
      "RunStatus": {
        "description": "Outcome of a run attempt after it has finished, or ``running`` while it is open.",
        "enum": [
          "running",
          "succeeded",
          "partial",
          "failed"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "RunsMeta": {
        "additionalProperties": false,
        "description": "Pagination metadata for a run list.",
        "properties": {
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as `cursor` for the next page; null on the last page",
            "title": "Next Cursor"
          }
        },
        "title": "RunsMeta",
        "type": "object"
      },
      "RunsResponse": {
        "additionalProperties": false,
        "description": "Body of ``GET /v1/runs``, newest first.",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Run"
            },
            "title": "Data",
            "type": "array"
          },
          "meta": {
            "$ref": "#/components/schemas/RunsMeta"
          }
        },
        "required": [
          "data",
          "meta"
        ],
        "title": "RunsResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "YieldLens ingestion",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Liveness: the process is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: the ING schema is reachable.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready"
      }
    },
    "/v1/runs": {
      "get": {
        "description": "Attempts of this service, newest first; ``from`` and ``to`` are inclusive UTC dates.",
        "operationId": "list_runs_endpoint_v1_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[1-9][0-9]{0,17}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Invalid query"
          }
        },
        "summary": "List Runs Endpoint"
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "description": "Every attempt of one run id, in attempt order.",
        "operationId": "get_run_v1_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunAttemptsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {}
            },
            "description": "Unknown run"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Run"
      }
    }
  }
}
