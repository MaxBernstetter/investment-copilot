{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "size": "size-limit",
    "e2e": "playwright test"
  },
  "size-limit": [
    {
      "name": "initial JS (raised 2026-10-23 for the curve catalogue and measures UI, and for the shared DataTable)",
      "path": "dist/assets/index-*.js",
      "limit": "185 kB",
      "gzip": true
    },
    {
      "name": "all JS",
      "path": "dist/assets/*.js",
      "limit": "500 kB",
      "gzip": true
    },
    {
      "name": "CSS",
      "path": "dist/assets/*.css",
      "limit": "45 kB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@mantine/charts": "9.7.2",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@tabler/icons-react": "3.48.0",
    "openapi-fetch": "0.14.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@size-limit/file": "14.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "size-limit": "14.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
