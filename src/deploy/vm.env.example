# Template for the VM .env: copy to /opt/yieldlens/.env, chmod 600, replace every value. Never commit the real file. task deploy:config validates the overlay with these placeholders.

# GHCR user and a classic PAT with read:packages only (the VM never pushes).
GHCR_USER=maxbernstetter
GHCR_TOKEN=change-me

# Public domain (DuckDNS) and the Let's Encrypt contact.
YIELDLENS_DOMAIN=yieldlens.duckdns.org
YIELDLENS_ACME_EMAIL=ops@example.org

# Oracle schema owners and application users (the Liquibase migrations and the apis).
PERSISTENCE_DB_ADMIN_PASSWORD=change-me
PERSISTENCE_DB_OWNER_PASSWORD=change-me
PERSISTENCE_DB_PASSWORD=change-me
INGESTION_DB_OWNER_PASSWORD=change-me
INGESTION_DB__PASSWORD=change-me
PROCESSING_DB_OWNER_PASSWORD=change-me
PROCESSING_DB__PASSWORD=change-me

# Grafana admin login (user admin, reachable through the SSH tunnel only).
GRAFANA_ADMIN_PASSWORD=change-me

# Airflow admin login and its metadata database.
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_POSTGRES_PASSWORD=change-me

# Fernet key for Airflow connections. Generate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=change-me

# Secret for the Airflow API JWTs.
AIRFLOW__API_AUTH__JWT_SECRET=change-me

# Group id of the docker socket on the VM. Get it with: stat -c %g /var/run/docker.sock
DOCKER_GID=999
