{
  "uid": "processing",
  "title": "Processing",
  "schemaVersion": 41,
  "editable": true,
  "tags": ["yieldlens", "processing"],
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "refresh": "1m",
  "links": [
    {
      "title": "Traces",
      "type": "link",
      "url": "/explore?left={\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"queryType\":\"traceql\",\"query\":\"{resource.service.name=~\\\"processing-api|processing-job\\\"}\"}]}",
      "targetBlank": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false,
      "tags": [],
      "tooltip": "Open processing traces in Tempo"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "curve",
        "label": "Curve",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(yl_processing_quality_checks_total, curve)",
        "definition": "label_values(yl_processing_quality_checks_total, curve)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "current": {"text": ["All"], "value": ["$__all"]},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "row", "title": "API", "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "panels": []
    },
    {
      "id": 2, "type": "timeseries", "title": "Request rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 1, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"processing-api\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Error rate (5xx)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 1, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"processing-api\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"processing-api\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Duration p95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 1, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"processing-api\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5, "type": "row", "title": "Quality checks", "collapsed": false,
      "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1}, "panels": []
    },
    {
      "id": 6, "type": "timeseries", "title": "Checks by status",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 10, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (status) (increase(yl_processing_quality_checks_total{curve=~\"$curve\"}[1h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Findings by rule and severity",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 10, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (rule, severity) (increase(yl_processing_quality_findings_total{curve=~\"$curve\"}[1h]))",
          "legendFormat": "{{rule}} {{severity}}"
        }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Values checked",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 10, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (curve) (increase(yl_processing_values_checked_total{curve=~\"$curve\"}[1h]))",
          "legendFormat": "{{curve}}"
        }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Check duration p95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 18, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (le, curve) (rate(yl_processing_quality_check_duration_seconds_bucket{curve=~\"$curve\"}[1h])))",
          "legendFormat": "{{curve}}"
        }
      ]
    },
    {
      "id": 10, "type": "table", "title": "quality-warn alert",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 18, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "yl_processing_alert_active{alert=\"quality-warn\",curve=~\"$curve\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 11, "type": "stat", "title": "Time since last check",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 18, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "time() - yl_processing_quality_last_success_timestamp_seconds{curve=~\"$curve\"}",
          "legendFormat": "{{curve}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12, "type": "row", "title": "Traces", "collapsed": false,
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 1}, "panels": []
    },
    {
      "id": 13, "type": "traces", "title": "Recent traces",
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"x": 0, "y": 27, "w": 24, "h": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "tempo", "uid": "tempo"},
          "queryType": "traceql",
          "query": "{resource.service.name=~\"processing-api|processing-job\"}",
          "limit": 20
        }
      ]
    }
  ]
}
